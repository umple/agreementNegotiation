

class AgreementProcessorMain {
  public static void main(String[] args) 
  {
    if (args.length < 2)
    {
      System.out.println("Usage: java AgreementProcessorMain <data_dir> <output_dir>" + System.lineSeparator());
      return;
    }
     
    String dataDirectory = args[0];
    String outputDirectory = args[1];
    AgreementProcessor agg = new AgreementProcessor 
      (dataDirectory,outputDirectory);
    boolean didGenerate = agg.generate();
    
    for (String message : agg.getMessages())
    {
      System.out.println(message);
    }
    if (didGenerate)
    {
      System.out.println("Success processing agreements!");
    }
    System.exit(agg.isSeriousProblem() ? -1 : 0);
  }

}

class AgreementProcessor {
  depend java.util.Arrays;
  depend cruise.umple.parser.ParseResult;
  depend cruise.umple.parser.Token;

  public boolean generate() {
    if (!isReadableFile(new File(AgreementParser.GRAMMAR)))
    {
      reportProblem("Error: Cannot read " + AgreementParser.GRAMMAR + "; run the program in the directory that holds it");
      return false;
    }
    File inputDirectory = new File(getInputPath());
    String[] pathnames = inputDirectory.list();
    if (pathnames == null)
    {
      reportProblem("Error: Cannot list directory " + getInputPath());
      return false;
    }

    setParser(new AgreementParser());
    Arrays.sort(pathnames);
    for (String aPathName : pathnames)
    {
      if (aPathName.endsWith(".txt"))
      {
        parseAgreement(new File(inputDirectory, aPathName));
      }
    }
    return !isSeriousProblem();
  }

  // Reports the clauses of one agreement, or why it could not be parsed
  private void parseAgreement(File agreementFile)
  {
    String name = agreementFile.getName();
    if (!isReadableFile(agreementFile))
    {
      reportProblem("Error: Cannot read agreement " + name);
      return;
    }
    ParseResult result = getParser().parse(agreementFile);
    // The parser warns only when it cannot read a file, here the agreement or the grammar, both needed
    if (!result.getWasSuccess() || result.getHasWarnings())
    {
      reportProblem("Error: Unable to parse agreement " + name + System.lineSeparator() + result.toString().trim());
      return;
    }
    Token agreement = getParser().getRootToken().getSubToken("agreement");
    if (agreement == null)
    {
      reportProblem("Error: " + AgreementParser.GRAMMAR + " does not start with the agreement rule");
      return;
    }
    addMessage("Parsed " + name);
    for (Token clause : agreement.getSubTokens())
    {
      addMessage("  " + clause);
    }
  }

  private void reportProblem(String message)
  {
    addMessage(message);
    setSeriousProblem(true);
  }

  private static boolean isReadableFile(File file)
  {
    return file.isFile() && file.canRead();
  }
}

class AgreementParser {
  const String GRAMMAR = "Agreement.grammar";

  after constructor {
    addGrammarFile(GRAMMAR);
  }
}
